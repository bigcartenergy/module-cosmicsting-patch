{
    "name": "bigcartenergy/module-cosmicsting-patch",
    "description": "Free security patch for Magento Open Source and Mage-OS by Big Cart Energy: closes CVE-2024-34102 (CosmicSting) on the Magento 2.3 and 2.4 releases that have no official fix, as one plugin on the Web API input processor that applies the rule of Adobe's fix. No core file is modified.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://bigcartenergy.com",
    "authors": [
        {
            "name": "Big Cart Energy",
            "email": "hello@bigcartenergy.com"
        }
    ],
    "keywords": [
        "magento2",
        "magento 2",
        "mage-os",
        "security",
        "security patch",
        "cve-2024-34102",
        "cosmicsting",
        "webapi"
    ],
    "require": {
        "php": "~7.1.3 || ~7.2.0 || ~7.3.0 || ~7.4.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^102.0 || ^103.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BigCartEnergy\\CosmicStingPatch\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "support": {
        "email": "hello@bigcartenergy.com",
        "issues": "https://github.com/bigcartenergy/module-cosmicsting-patch/issues",
        "source": "https://github.com/bigcartenergy/module-cosmicsting-patch"
    }
}
